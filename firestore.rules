// Firestore rules for the WHOLE mathlessons-7cc22 project, not just the monitor.
// MASTER COPY: Student Monitor/firestore.rules. This file must stay identical to it.
// Deploying replaces the live ruleset. The slides / sessions / satAttempts blocks are
// copied from SAT Math/sat-math-course/firestore.rules and must stay. Keep the two files
// identical: deploy SAT with `firebase deploy --only hosting`, rules only from here.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTutor() {
      return request.auth != null
        && request.auth.token.email == 'mrtatwellhtmls@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function str(v, max) { return v is string && v.size() <= max; }
    function num(v, lo, hi) { return v is number && v >= lo && v <= hi; }

    match /slides/{slideId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      match /participants/{participantId} {
        allow read: if true;
        allow write: if true;
      }

      match /answers/{answerId} {
        allow read: if request.auth != null;
        allow write: if true;
      }
    }

    // SAT workbook attempt log (workbook/public). Students write one record
    // per question without signing in; only the tutor can read or delete.
    match /satAttempts/{attemptId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['student', 'sid', 'qid', 'topic', 'topicTitle', 'difficulty', 'type',
             'given', 'answer', 'result', 'stem', 'at'])
        && str(request.resource.data.student, 60)
        && str(request.resource.data.sid, 40)
        && str(request.resource.data.qid, 40)
        && str(request.resource.data.topic, 20)
        && str(request.resource.data.topicTitle, 120)
        && str(request.resource.data.difficulty, 20)
        && str(request.resource.data.type, 10)
        && str(request.resource.data.given, 200)
        && str(request.resource.data.answer, 200)
        && str(request.resource.data.stem, 2000)
        && request.resource.data.result in ['correct', 'wrong', 'skipped']
        && request.resource.data.at == request.time;
      allow read, delete: if isTutor();
    }

    // ---------- Student Monitor (Student Monitor/) ----------
    function siteId(v) { return v is string && v.matches('^[a-z0-9-]{2,40}$'); }
    function who(d) {
      return siteId(d.site) && str(d.sid, 40) && d.sid.size() >= 8
        && str(d.student, 60) && d.student.size() > 0 && str(d.skey, 60);
    }

    // One record per thing a student did, written by the site (no sign-in). Never changed.
    match /monEvents/{eventId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['site', 'sid', 'student', 'skey', 'kind', 'item', 'title', 'group', 'secs',
             'right', 'total', 'score', 'max', 'note', 'detail', 'clientAt', 'at'])
        && request.resource.data.keys().hasAll(['site', 'sid', 'student', 'skey', 'kind', 'at'])
        && who(request.resource.data)
        && request.resource.data.kind in ['open', 'visit', 'lesson', 'mock', 'lab', 'attempt', 'other']
        && str(request.resource.data.get('item', ''), 120)
        && str(request.resource.data.get('title', ''), 200)
        && str(request.resource.data.get('group', ''), 120)
        && num(request.resource.data.get('secs', 0), 0, 86400)
        && num(request.resource.data.get('right', 0), 0, 100000)
        && num(request.resource.data.get('total', 0), 0, 100000)
        && num(request.resource.data.get('score', 0), 0, 100000)
        && num(request.resource.data.get('max', 0), 0, 100000)
        && str(request.resource.data.get('note', ''), 1000)
        && str(request.resource.data.get('detail', ''), 20000)
        && str(request.resource.data.get('clientAt', ''), 40)
        && request.resource.data.at == request.time;
      allow read, delete: if isTutor();
    }

    // One summary per student per site per device: id is "<site>_<sid>". The site overwrites it.
    match /monStudents/{docId} {
      allow create, update: if request.resource.data.keys().hasOnly(
            ['site', 'sid', 'student', 'skey', 'last', 'secs', 'done', 'total', 'xp', 'lastAt'])
        && who(request.resource.data)
        && docId == request.resource.data.site + '_' + request.resource.data.sid
        && str(request.resource.data.get('last', ''), 200)
        && num(request.resource.data.get('secs', 0), 0, 10000000)
        && num(request.resource.data.get('done', 0), 0, 100000)
        && num(request.resource.data.get('total', 0), 0, 100000)
        && num(request.resource.data.get('xp', 0), 0, 10000000)
        && request.resource.data.lastAt == request.time;
      allow read, delete: if isTutor();
    }

    // Tutor's merges: monAliases/<name key> = { to: <name key> }. Tutor only.
    match /monAliases/{key} {
      allow read, write: if isTutor();
    }
  }
}
